generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gasto {
  id            Int        @id @default(autoincrement())
  usuarioId     String
  gasto         Float
  montoAnterior Float
  fecha         DateTime
  categoriaId   Int
  categoria     Categorias @relation(fields: [categoriaId], references: [id])
}

model Ingreso {
  id            Int      @id @default(autoincrement())
  usuarioId     String
  ingreso       Decimal
  montoAnterior Float
  fecha         DateTime
}

model Categorias {
  id          Int                    @id @default(autoincrement())
  usuarioId   String
  nombre      String
  icono       String?
  color       String?
  descripcion String?
  editable    Boolean                @default(true)
  gastos      Gasto[]
  presupuesto PresupuestoCategoria[]
}

model Presupuesto {
  id                   Int                    @id @default(autoincrement())
  usuarioId            String
  monto                Int
  fechaInicio          DateTime
  fechaFin             DateTime
  PresupuestoCategoria PresupuestoCategoria[]
}

model PresupuestoCategoria {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  categoriaId   Int
  monto         Int
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id])
  categoria     Categorias  @relation(fields: [categoriaId], references: [id])
}

model Usuario {
  id          String  @id
  nombre      String
  email       String  @unique
  isDeveloper Boolean @default(false)
  APISecret   String?
}

model Racha {
  usuarioId   String   @id @unique
  rachaActual Int
  ultimaFecha DateTime
  isInactive  Boolean  @default(true)
}

model Niveles {
  id            Int            @id @default(autoincrement())
  objetivos     Objetivos[]
  nivelUsuarios NivelUsuario[]
}

model Objetivos {
  id                Int                @id @default(autoincrement())
  descripcion       String
  condicion         String
  nivelId           Int
  niveles           Niveles            @relation(fields: [nivelId], references: [id])
  objetivosUsuarios ObjetivosUsuario[]
}

model NivelUsuario {
  id                Int                @id @default(autoincrement())
  usuarioId         String             @unique
  nivelId           Int
  niveles           Niveles            @relation(fields: [nivelId], references: [id])
  objetivosUsuarios ObjetivosUsuario[]
}

model ObjetivosUsuario {
  id           Int          @id @default(autoincrement())
  usuarioNivel Int
  objetivoId   Int
  isCompleted  Boolean      @default(false)
  nivelUsuario NivelUsuario @relation(fields: [usuarioNivel], references: [id])
  objetivo     Objetivos    @relation(fields: [objetivoId], references: [id])

  @@unique([usuarioNivel, objetivoId])
}
